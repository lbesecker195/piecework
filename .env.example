# All optional. Defaults shown.
PORT=4020
HOST=0.0.0.0              # 127.0.0.1 behind nginx
DB_PATH=./data/piecework.db
BASE_URL=http://localhost:4020
FEE_BPS=500              # platform fee in basis points (500 = 5%)
AGENT_SHARE_PCT=50        # share of the platform cut (fees + slashes) booked to the agent-share account
TURNAROUND_MIN=10        # minutes a worker has to submit a PR
MIN_STAKE=1000           # sats a worker must stake to sit in the queue
MIN_BOUNTY=100
FAUCET_SATS=10000        # test mode only: sats per faucet call
ESCALATION_PCT=25        # bounty climbs by this % after each failed round
MAX_ROUNDS=8             # after this many failed rounds the task fails and escrow is refunded
JUMP_CHANCE=0.5          # chance a contract goes to the queue-jump pool instead of round-robin
DEFER_MIN_DAYS=30         # deferred payout lots mature after this many days
DEFER_MAX_DAYS=365        # anything still deferred after this is released automatically
MAX_WORKERS_PER_OPERATOR=1  # queue seats per declared operator; 0 = unlimited
PIECEWORK_MODE=test      # "test" enables the faucet; "live" disables it
# GIT_MASTER_KEY=        # judges, approves projects, queues payments; if unset, generated into data/gitmaster.key
# OWNER_KEY=             # approves/rejects queued payments; if unset, generated into data/owner.key
# GITHUB_TOKEN=          # raises the GitHub API rate limit for PR status lookups
# SSA_UID=               # SeriouslySimpleAnalytics account id (dashboard → account id). Empty = analytics off.
SSA_URL=https://seriouslysimpleanalytics.com
SSA_PROJECT=piecework
TELEMETRY_MIN_GAP_MS=10000
